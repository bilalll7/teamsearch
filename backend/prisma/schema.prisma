// Prisma schema for TeamSearch MVP
// Based on docs/PRD.md v1.2 and docs/PRODUCT_DECISIONS.md v1.2

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// PD-01: Multi-campus architecture, pilot one campus
model Campus {
  id           String          @id @default(cuid())
  namaCampus   String          @unique // [INPUT PILOT] - placeholder
  createdAt    DateTime        @default(now())
  
  allowedDomains AllowedDomain[]
  users          User[]
}

model AllowedDomain {
  id        String   @id @default(cuid())
  campusId  String
  domain    String   // [INPUT PILOT] - e.g., @student.[INPUT PILOT]
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  
  @@unique([campusId, domain])
  @@index([domain, aktif])
}

// Auth & User
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String    // bcrypt (replacing Argon2id due to Windows build issues)
  campusId          String
  statusVerifikasi  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  
  campus            Campus    @relation(fields: [campusId], references: [id])
  profile           Profile?
  refreshTokens     RefreshToken[]
  opportunitiesOwned Opportunity[]
  applications      Application[]
  notifications     Notification[]
  // ponytail: EmailVerificationToken & PasswordResetToken entities pending D-07 decision
  
  @@index([email])
  @@index([campusId])
}

// PD-07: Refresh token with rotation & reuse detection
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // hash stored, not plaintext
  familyId  String    // for reuse detection
  expiresAt DateTime  // 7 days per PD-07
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([familyId])
}

// Profile & Skills
model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  namaTampilan    String
  bio             String?  @db.Text // ≤300 chars validated in app
  programStudi    String?
  angkatan        String?
  headline        String?  @db.VarChar(160)
  lokasi          String?  @db.VarChar(120)
  avatarUrl       String?  @db.VarChar(500)
  resumeUrl       String?  @db.VarChar(500)
  pengalaman      Json?
  pendidikan      Json?
  ketersediaan    Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioLinks  PortfolioLink[]
  userSkills      UserSkill[]
}

model PortfolioLink {
  id        String @id @default(cuid())
  profileId String
  label     String
  url       String
  tipe      String // github/linkedin/behance/lainnya
  
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model SkillCategory {
  id    String @id @default(cuid())
  nama  String @unique
  
  skills Skill[]
}

model Skill {
  id              String   @id @default(cuid())
  nama            String
  kategoriSkillId String
  status          String   @default("aktif") // aktif/antrean per PD-03
  
  kategori        SkillCategory @relation(fields: [kategoriSkillId], references: [id])
  userSkills      UserSkill[]
  positionRequirements PositionSkillRequirement[]
  
  @@unique([nama, kategoriSkillId])
  @@index([status])
}

model UserSkill {
  id        String @id @default(cuid())
  profileId String
  skillId   String
  level     Int    @default(1) // 1-3
  
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Restrict) // PD-03: skills in use cannot be deleted
  
  @@unique([profileId, skillId])
}

// Opportunity & Position
model Opportunity {
  id          String   @id @default(cuid())
  ownerId     String
  judul       String
  deskripsi   String   @db.Text
  jenis       String   // lomba/proyek
  kategori    String
  mode        String   // online/offline/hybrid
  tenggat     DateTime?
  status      String   @default("draft") // draft/open/closed/expired
  // ponytail: D-03 decision pending — formed is derived or stored?
  // Current: stored as enum value. If derived chosen, will remove from enum and calculate via TeamMembership count.
  createdAt   DateTime @default(now())
  
  owner       User     @relation(fields: [ownerId], references: [id])
  positions   Position[]
  teamMembers TeamMembership[]
  
  @@index([ownerId])
  @@index([status])
}

model Position {
  id            String   @id @default(cuid())
  opportunityId String
  nama          String
  jumlahSlot    Int      @default(1)
  deskripsi     String?  @db.Text
  
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skillRequirements PositionSkillRequirement[]
  applications  Application[]
  teamMembers   TeamMembership[]
}

// PD-05: Fixed weights must_have=5, nice_to_have=2
model PositionSkillRequirement {
  id            String @id @default(cuid())
  positionId    String
  skillId       String
  jenis         String // must_have/nice_to_have
  bobot         Int    // derived from jenis: must_have=5, nice_to_have=2
  levelMinimum  Int    @default(1)
  
  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Restrict)
  
  @@unique([positionId, skillId])
}

// Application & Team
// ponytail: D-04 decision pending — "aktif" status definition & unique constraint for reapply after rejected/withdrawn
// Current: unique per (position, applicant) without status filter. May need partial unique index.
model Application {
  id                    String    @id @default(cuid())
  positionId            String
  applicantId           String
  pesan                 String?   @db.Text // ≤500 chars
  status                String    @default("pending") // pending/shortlisted/accepted/rejected/withdrawn
  skorKecocokkanSaatLamar Float?
  createdAt             DateTime  @default(now())
  decidedAt             DateTime?
  
  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  applicant   User     @relation(fields: [applicantId], references: [id])
  contactExchange ContactExchange?
  
  @@unique([positionId, applicantId]) // ponytail: may need partial unique WHERE status IN (...)
  @@index([applicantId])
  @@index([status])
}

// ponytail: D-01 decision pending — does owner have a TeamMembership row?
// Current: includes owner as a row. If owner-synthesis chosen, will exclude owner rows.
// ponytail: D-02 decision pending — precise definition of "aktif" status
model TeamMembership {
  id            String    @id @default(cuid())
  opportunityId String
  positionId    String
  userId        String
  peran         String?
  status        String    @default("aktif") // aktif/keluar/dikeluarkan
  joinedAt      DateTime  @default(now())
  leftAt        DateTime?
  
  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  position    Position    @relation(fields: [positionId], references: [id])
  
  @@unique([opportunityId, userId])
}

// PD-04: Email never public, opt-in contact exchange
// ponytail: D-06 decision pending — 1-to-0..1 or 1-to-N if reapply after rejected allowed
model ContactExchange {
  id            String    @id @default(cuid())
  applicationId String    @unique // ponytail: may remove @unique if 1-to-N chosen
  requestedBy   String
  requestedAt   DateTime  @default(now())
  consentedBy   String?
  consentedAt   DateTime?
  status        String    @default("pending") // pending/approved/rejected
  createdAt     DateTime  @default(now())
  
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// Notification
// ponytail: D-08 decision pending — entitas_ref needs entitas_tipe for proper de-dup
model Notification {
  id            String   @id @default(cuid())
  userId        String
  tipePeristiwa String   // contact_requested/contact_approved/contact_rejected/etc
  entitasRef    String   // ponytail: should be split into entitasTipe + entitasId
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, isRead])
}
